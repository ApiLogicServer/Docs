digraph G {
  rankdir=TB; nodesep=0.4; ranksep=0.5; bgcolor="white";
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#5b6b7a", fontcolor="#1d2733", margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#5b6b7a", fontcolor="#1d2733"];

  req  [label=<<b>1. Requirements</b><br/><font point-size="10">samples/requirements/demo_eai<br/>5 short requirements</font>>];
  leg0 [label=<<b>2. Legacy system</b><br/><font point-size="10">samples/native_ai/demo_eai_native<br/>built without GenAI-Logic<br/>code + tests + docs</font>>];
  leg1 [label=<<b>3. Legacy, docs removed</b><br/><font point-size="10">samples/native_ai/<br/>demo_eai_legacy<br/>code + tests only</font>>, fillcolor="#fdf1e3", color="#b9783a"];
  rec  [label=<<b>4. Recovered requirements</b><br/><font point-size="10">samples/requirements/<br/>demo_eai_modernize/demo_eai/<br/>requirements.md</font>>, fillcolor="#fdf1e3", color="#b9783a"];
  mod  [label=<<b>5. Modernized system</b><br/><font point-size="10">demo_eai_modernized<br/>declarative rules, tests,<br/>ad-libs + traceability report</font>>, fillcolor="#e4f3ea", color="#3d8a5c"];

  ref  [label=<<b>Reference implementation</b><br/><font point-size="10">samples/basic_demo_eai<br/>built from the same requirements<br/>with GenAI-Logic</font>>, fillcolor="#e4f3ea", color="#3d8a5c"];

  req  -> leg0 [label=" AI builds\n (no GenAI-Logic)"];
  leg0 -> leg1 [label=" remove\n the docs"];
  leg1 -> rec  [label=" Antigravity reads\n the code"];
  rec  -> mod  [label=" Antigravity + GenAI-Logic\n context engineering"];


  req -> ref [label=" AI + GenAI-Logic\n context engineering"];
  ref -> mod [style=dashed, constraint=false, dir=both, label=" compared:\n same result"];
  {rank=same; leg0; ref;}
}
